# Copy to ~/docker/gmc-cloud/.env (chmod 600). Never commit the real file.

# The public app key built into GMC (APP_ANON_KEY in secrets.defaults.properties). Required.
APP_ANON_KEY=

# Database password for the bundled PostgreSQL. Generate: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# Where the TV QR points: the approval page on this server.
SITE_URL=https://gmc.projectneverland.gr
TV_AUTH_VERIFY_BASE_URL=https://gmc.projectneverland.gr/tv

# Accounts allowed into the admin page (/admin), comma-separated. Empty = the page refuses everyone.
GMC_ADMIN_EMAILS=

# Optional: server-side proxies used by the app/dashboard. Empty = proxy reports "not configured".
TMDB_API_KEY=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=

# ARVIO_AUTH_SECRET is generated on first start into data/.auth-secret. Back it up:
# losing it signs every device out.
